# Optional. The key is normally read from your shell (export ANTHROPIC_API_KEY=...).
# Copy to .env only to override settings for this project. Never commit .env.
# ANTHROPIC_API_KEY=

# Optional: turns on dropping call recordings into the review app (npm run app).
# Deepgram speech-to-text, about $0.0043 per minute of audio. Role-play recordings only until approval.
# DEEPGRAM_API_KEY=

# Optional overrides (defaults shown)
# DETECTOR_MODEL=claude-haiku-5-5
# COACH_MODEL=claude-sonnet-5-5
# COACH_EFFORT=low
# GUARD_MODEL=claude-haiku-5-5
